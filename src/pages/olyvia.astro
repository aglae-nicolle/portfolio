---
import Layout from "../layouts/Layout.astro";
import OutilItem from "../components/OutilItem.astro";
import GalerieProjet from "../components/GalerieProjet.astro";
import { getProjet, getOutilsDuProjet, getImagesDuProjet } from "../lib/db";
import { getImageUrl, stripHtml } from "../js/backend";

const id = Number(Astro.params.id);
const projet = Number.isInteger(id) ? getProjet(id) : null;
if (!projet) return Astro.redirect("/404");

const outils = getOutilsDuProjet(id);
const imageCard = getImageUrl(projet, "imageCard");
// On ne garde que les images réellement affichables.
// Le texte alternatif vient de IMAGE.altImg (il s'affiche aussi en légende au survol).
const images = getImagesDuProjet(id)
    .map((i, idx) => ({
        src: getImageUrl(i, "img"),
        alt: i.altImg?.trim() || `${projet.nomProjet} – image ${idx + 1}`,
    }))
    .filter((i): i is { src: string; alt: string } => Boolean(i.src));

// Sommaire : « Compétences » + chaque <h2> du contenu stocké en base (on leur ajoute un id pour les ancres).
const sommaire: { id: string; titre: string }[] = [];
if (outils.length > 0)
    sommaire.push({ id: "competences", titre: "Compétences" });
let n = 0;
const contenu = (projet.contenuPageProjet ?? "").replace(
    /<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/gi,
    (_m, attrs = "", titre) => {
        const ancre = `section-${++n}`;
        sommaire.push({ id: ancre, titre: stripHtml(titre) });
        return `<h2 id="${ancre}"${attrs}>${titre}</h2>`;
    },
);
---

<Layout
    title={projet.nomProjet}
    description={stripHtml(projet.descriptionProjet) || undefined}
>
    <article>
        <!-- En-tête du projet -->
        <header class="container-page grid grid-cols-[144px_1fr] gap-x-2.5 pt-9 lg:grid-cols-[480px_1fr] lg:gap-x-21.25 lg:pt-20">
            <div class="col-span-2 flex items-start justify-between gap-4 lg:col-span-1 lg:col-start-2 lg:row-start-1 lg:mt-3">
                <h1
                    class="text-h1"
                    style={`view-transition-name: projet-titre-${id}`}
                >
                    {projet.nomProjet}
                </h1>
                {projet.urlProjet && (
                    <a
                        href={projet.urlProjet}
                        target="_blank"
                        rel="noopener"
                        class="btn w-47 shrink-0 lg:w-71"
                    >
                        &lt;Consulter le site&gt;
                    </a>
                )}
            </div>

            <div
                class="mt-6.5 size-36 overflow-hidden rounded-[15px] border border-vert-clair bg-marron-clair lg:row-span-3 lg:row-start-1 lg:mt-0 lg:size-120 lg:rounded-[40px]"
                style={`view-transition-name: projet-image-${id}`}
            >
                {imageCard && (
                    <img
                        src={imageCard}
                        alt={`Aperçu du projet ${projet.nomProjet}`}
                        class="size-full object-cover"
                    />
                )}
            </div>

            <div class="mt-10.5 lg:col-start-2 lg:mt-8.5">
                {projet.anneeRealisation && (
                    <p class="text-[12px] leading-[1.3] lg:text-b2">
                        réalisé en{" "}
                        <span class="font-semibold">
                            {projet.anneeRealisation}
                        </span>
                    </p>
                )}
                <div
                    class="mt-4.5 text-[14px] leading-[1.2] lg:mt-6.5 lg:text-[18px]"
                    set:html={projet.descriptionProjet ?? ""}
                />
            </div>

            {sommaire.length > 0 && (
                <nav
                    class="col-span-2 mt-4 pl-4 lg:col-span-1 lg:col-start-2 lg:mt-6.5 lg:pl-0"
                    aria-label="Sommaire"
                >
                    <p class="text-h3 text-marron-fonce">Sommaire</p>
                    <ol class="text-[12px] leading-[1.4] lg:text-btn">
                        {sommaire.map((s, i) => (
                            <li>
                                <a href={`#${s.id}`} class="lien-sommaire">
                                    {i + 1}- {s.titre}
                                </a>
                            </li>
                        ))}
                    </ol>
                </nav>
            )}
        </header>

        <!-- Outils utilisés -->
        {outils.length > 0 && (
            <section
                id="competences"
                class="mt-12 scroll-mt-22.5 bg-vert-clair py-12 lg:mt-20 lg:scroll-mt-27.5 lg:py-19.75"
            >
                <div class="container-page lg:pl-32.25">
                    <h2 class="text-h2">
                        <span class="lg:hidden">Compétences</span>
                        <span class="hidden lg:inline">
                            Mes outils utilisés
                        </span>
                    </h2>
                    <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 lg:mt-9.25 lg:gap-x-20.25 lg:gap-y-4.75">
                        {outils.map((o) => (
                            <OutilItem outil={o} taille="grande" />
                        ))}
                    </ul>
                </div>
            </section>
        )}

        <!-- Contenu éditorial (HTML stocké en base) -->
        <div class="container-page mt-10 lg:mt-26.25">
            <div class="prose-projet" set:html={contenu} />

            {images.length > 0 && (
                <GalerieProjet
                    images={images}
                    titre={`Galerie du projet ${projet.nomProjet}`}
                />
            )}
        </div>
        <div class="h-16 lg:h-27.5"></div>
    </article>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import OutilItem from "../components/OutilItem.astro";
import GalerieProjet from "../components/GalerieProjet.astro";
import { getProjet, getOutilsDuProjet, getImagesDuProjet } from "../lib/db";
import { urlImageCard, urlImageGalerie, stripHtml } from "../js/backend";

// PAGE DE TEST (brouillon) : sert à prévisualiser le HTML de `contenuPageProjet`
// avant de le copier dans la base. Accessible uniquement avec `astro dev`
// (http://localhost:4321/brouillon-projet) : sur le site en ligne, elle renvoie une 404.
if (!import.meta.env.DEV) {
    return new Response(null, { status: 404 });
}

// Projet de la base utilisé pour l'en-tête (titre, image, description, outils, galerie).
const id = 1;
const projet = getProjet(id);
if (!projet)
    throw new Error(
        `Page de test : aucun projet avec l'id ${id} dans la base.`,
    );

// HTML à tester : écris-le ici, puis copie-le dans PROJET.contenuPageProjet une fois validé.
// Chaque <h2> ajoute automatiquement une entrée dans le sommaire.
const contenuTest = `
<h2>Le projet</h2>
<p>
    Ce projet a été réalisé dans un cadre d'évaluation de mi-semestre dans un délais de 3 jours. Il nous était demandé de créer un site web qui permet aux utilisateurs de commander des montres personnalisées. Nos missions étaient de créer une identité visuelle, une stratégie de communication, une base de donnée et une maquette et 3 pages d'un site web.<br/>
    <br/>
    Dans le sujet, il nous était demandé de créer un site avec une identité raffinée, minimaliste et épurée qui s'adresse à un publique unisexe entre 25 et 40 ans. Nous avions comme informations la marque, TiK•TaK, et sa philosophie, la fabrication française.
</p>
`;

const outils = getOutilsDuProjet(id);
const imageCard = urlImageCard(projet);
// On ne garde que les images réellement affichables.
// Le texte alternatif vient de IMAGE.altImg (il s'affiche aussi en légende au survol).
const images = getImagesDuProjet(id)
    .map((i, idx) => ({
        src: urlImageGalerie(i),
        alt: i.altImg?.trim() || `${projet.nomProjet} – image ${idx + 1}`,
    }))
    .filter((i): i is { src: string; alt: string } => Boolean(i.src));

// Sommaire : « Compétences » + chaque <h2> du contenu stocké en base (on leur ajoute un id pour les ancres).
const sommaire: { id: string; titre: string }[] = [];
if (outils.length > 0)
    sommaire.push({ id: "competences", titre: "Compétences" });
let n = 0;
const contenu = contenuTest.replace(
    /<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/gi,
    (_m, attrs = "", titre) => {
        const ancre = `section-${++n}`;
        sommaire.push({ id: ancre, titre: stripHtml(titre) });
        return `<h2 id="${ancre}"${attrs}>${titre}</h2>`;
    },
);
---

<Layout
    title={projet.nomProjet}
    description={stripHtml(projet.descriptionProjet) || undefined}
    noindex
>
    <article>
        <!-- En-tête du projet -->
        <header class="container-page grid grid-cols-[144px_minmax(0,1fr)] gap-x-2.5 pt-9 lg:grid-cols-[min(480px,40%)_minmax(0,1fr)] lg:gap-x-12 lg:pt-20 xl:gap-x-21.25">
            <div class="col-span-2 flex flex-wrap items-end justify-between gap-4 lg:col-span-1 lg:col-start-2 lg:row-start-1 lg:mt-3">
                <h1
                    class="text-h1"
                    style={`view-transition-name: projet-titre-${id}`}
                >
                    {projet.nomProjet}
                </h1>
                {projet.urlProjet && (
                    <a
                        href={projet.urlProjet}
                        target="_blank"
                        rel="noopener"
                        class="btn mb-0.75 w-47 shrink-0 lg:mb-1 lg:w-71"
                    >
                        &lt;Consulter le site&gt;
                    </a>
                )}
            </div>

            <div
                class="mt-6.5 size-36 overflow-hidden rounded-[15px] border border-vert-clair bg-marron-clair lg:row-span-3 lg:row-start-1 lg:mt-0 lg:aspect-square lg:size-auto lg:w-full lg:rounded-[40px]"
                style={`view-transition-name: projet-image-${id}`}
            >
                {imageCard && (
                    <img
                        src={imageCard}
                        alt={`Aperçu du projet ${projet.nomProjet}`}
                        class="size-full object-cover"
                    />
                )}
            </div>

            <div class="mt-10.5 lg:col-start-2 lg:mt-8.5">
                {projet.anneeRealisation && (
                    <p class="text-[12px] leading-[1.3] lg:text-b2">
                        réalisé en{" "}
                        <span class="font-semibold">
                            {projet.anneeRealisation}
                        </span>
                    </p>
                )}
                <div
                    class="mt-4.5 text-[14px] leading-[1.2] lg:mt-6.5 lg:text-[18px]"
                    set:html={projet.descriptionProjet ?? ""}
                />
            </div>

            {sommaire.length > 0 && (
                <nav
                    class="col-span-2 mt-4 pl-4 lg:col-span-1 lg:col-start-2 lg:mt-6.5 lg:pl-0"
                    aria-label="Sommaire"
                >
                    <p class="text-h3 text-marron-fonce">Sommaire</p>
                    <ol class="text-[12px] leading-[1.4] lg:text-btn">
                        {sommaire.map((s, i) => (
                            <li>
                                <a href={`#${s.id}`} class="lien-sommaire">
                                    {i + 1}- {s.titre}
                                </a>
                            </li>
                        ))}
                    </ol>
                </nav>
            )}
        </header>

        <!-- Outils utilisés -->
        {outils.length > 0 && (
            <section
                id="competences"
                class="mt-12 scroll-mt-22.5 bg-vert-clair py-12 lg:mt-20 lg:scroll-mt-27.5 lg:py-19.75"
            >
                <div class="container-page lg:pl-32.25">
                    <h2 class="text-h2">
                        <span class="lg:hidden">Compétences</span>
                        <span class="hidden lg:inline">
                            Mes outils utilisés
                        </span>
                    </h2>
                    <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 lg:mt-9.25 lg:gap-x-20.25 lg:gap-y-4.75">
                        {outils.map((o) => (
                            <OutilItem outil={o} taille="grande" />
                        ))}
                    </ul>
                </div>
            </section>
        )}

        <!-- Contenu éditorial (HTML de test, voir contenuTest) -->
        <div class="container-page mt-10 lg:mt-26.25">
            <div class="prose-projet" set:html={contenu} />

            {images.length > 0 && (
                <GalerieProjet
                    images={images}
                    titre={`Galerie du projet ${projet.nomProjet}`}
                />
            )}
        </div>
        <div class="h-16 lg:h-27.5"></div>
    </article>
</Layout>
